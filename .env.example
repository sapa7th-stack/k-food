# Copy to .env.local. Use the project URL and publishable (or legacy anon) key.
# Do not use a service_role or secret key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Public read-only values embedded into the static Vercel build.
# The publishable key is safe for browser use; never put a service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
