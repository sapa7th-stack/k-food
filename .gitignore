# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/dev-server*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Android build and signing files
/android/.gradle/
/android/app/build/
/android/build/
/android/*.apk
/android/*.aab
/android/*.keystore
/android/*.jks
/android/keystore.properties
/play-store/*.aab
/play-store/*.apk
/.gradle-home/
/.android-home/
/.npm-cache/
/storage-staging/
/.jdk17/
/.jdk17.zip
/.android-sdk/
/.android-commandlinetools.zip

.vercel
